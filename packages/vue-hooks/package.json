    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^4.0.0",
    "babel-loader": "^10.0.0",
    "del": "^8.0.1",
