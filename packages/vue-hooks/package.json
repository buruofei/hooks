    "directory": "packages/vue-hooks"
  },
  "homepage": "https://github.com/buruofei/hooks/tree/master/packages/vue-hooks",
  "bugs": {
    "url": "https://github.com/buruofei/hooks/issues"
  },
  "scripts": {
    "build": "gulp && webpack --mode production",
    "build:umd": "webpack --mode production",
    "clean": "gulp clean",
    "dev": "vite",
    "type-check": "vue-tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "files": [
    "dist",
    "lib",
    "es",
    "metadata.json",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@babel/runtime": "^7.21.0",
    "dayjs": "^1.9.1",
