{
  "name": "ahooks-vue3",
  "version": "1.0.3",
  "description": "A high-quality & reliable Vue 3 Composition API hooks library, ported from ahooks",
  "keywords": [
    "vue-hooks",
    "vue3-hooks",
    "composition-api",
    "vue-composables",
    "ahooks-vue3",
    "ahooks",
    "vue3",
    "typescript",
    "react-to-vue",
    "hooks-library"
  ],
  "main": "./lib/index.js",
  "module": "./es/index.js",
  "types": "./lib/index.d.ts",
  "unpkg": "dist/ahooks-vue3.js",
  "sideEffects": false,
  "author": {
    "name": "v-hooks-team",
    "email": "v-hooks@example.com"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
